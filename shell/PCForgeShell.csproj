<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net9.0: the WindowsDesktop 9 runtime is installed on this machine, so the
         published exe stays tiny instead of carrying a whole .NET runtime. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PCForge</AssemblyName>
    <RootNamespace>PCForgeShell</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.4.0</Version>
    <Product>PCForge</Product>
    <AssemblyTitle>PCForge - build it, then find the wall</AssemblyTitle>
    <!-- the game page travels inside the exe; nothing to lose next to it -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\PCForge.html" LogicalName="PCForge.html" />
  </ItemGroup>

</Project>